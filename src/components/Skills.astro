---
const categorias = [
  {
    nombre: "Backend",
    tecnologias: [
      "Java",
      "Spring Boot",
      "Python",
      "FastAPI",
    ],
  },
  {
    nombre: "DevOps & Cloud",
    tecnologias: [
      "Docker",
      "GitHub Actions",
      "AWS",
      "CloudFormation",
    ],
  },
  {
    nombre: "Bases de datos",
    tecnologias: [
      "PostgreSQL",
      "SQL",
    ],
  },
  {
    nombre: "Frontend",
    tecnologias: [
      "Astro",
      "React",
      "TypeScript",
      "Tailwind CSS",
    ],
  },
  {
    nombre: "Herramientas",
    tecnologias: [
      "Git",
      "GitHub",
    ],
  },
];
---

<!-- TECNOLOGÍAS -->
<section
  id="tecnologias"
  class="content-section section-band"
  data-section
>
  <div class="section-shell">

    <div class="section-heading" data-reveal>
      <span class="section-number">02</span>

      <div>
        <p class="section-kicker">Stack</p>
        <h2>Tecnologías</h2>
      </div>
    </div>

    <div class="technologies-layout">

      <p class="technologies-intro" data-reveal>
        Tecnologías y herramientas que he utilizado en proyectos académicos,
        prácticas profesionales y proyectos personales, principalmente
        orientadas al desarrollo backend y DevOps.
      </p>

      <div class="technology-categories">

        {
          categorias.map((categoria, categoriaIndex) => (

            <div
              class="technology-category"
              data-reveal
              style={`--item-index:${categoriaIndex}`}
            >

              <h3 class="technology-category-title">
                {categoria.nombre}
              </h3>

              <div class="technology-cloud stagger-list">

                {
                  categoria.tecnologias.map((tecnologia, index) => (

                    <span
                      class="technology-pill"
                      data-reveal
                      style={`--item-index:${index}`}
                    >
                      <i></i>
                      {tecnologia}
                    </span>

                  ))
                }

              </div>

            </div>

          ))
        }

      </div>

    </div>

  </div>
</section>